FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
WORKDIR /app
COPY --chown=node:node framework/scripts/serve-product-launch.ts ./server.ts
COPY --chown=node:node product.json brand.svg ./
USER node
ENV PORT=3000
EXPOSE 3000
CMD ["node", "server.ts"]
